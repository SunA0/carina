# 生产环境配置（GO_ENV=prod 时加载）
# 真实部署建议不落地本文件，全部通过进程环境变量注入（本文件仅作演示）

GO_ENV=prod
SERVER_HOST=0.0.0.0
SERVER_PORT=9090
SERVER_MODE=release
SERVER_CORS_ORIGINS=http://localhost:3000

DB_MAX_IDLE=10
DB_MAX_OPEN=100

REDIS_DB=0

TRACING_ENABLED=true
TRACING_ENDPOINT=localhost:4318
TRACING_SAMPLE_RATE=0.1

LOCK_ENGINE=redis

APP_NAME=carina-example
GREETING=hello from production env
