# 开发环境配置（GO_ENV=dev 时加载）
# 优先级：进程环境变量 > 本文件
# 敏感字段约定仍由进程环境变量注入：DB_DSN / REDIS_ADDRESS / REDIS_PASSWORD / AUTH_JWT_SECRET

GO_ENV=dev
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_CORS_ORIGINS=http://localhost:3000

DB_MAX_IDLE=10
DB_MAX_OPEN=100

REDIS_DB=0

TRACING_ENABLED=false
TRACING_ENDPOINT=localhost:4318
TRACING_SAMPLE_RATE=1.0

# dummy（开发） / redis（生产）
LOCK_ENGINE=dummy

# ---- 业务自定义字段 ----
APP_NAME=carina-example
GREETING=hello from development env
